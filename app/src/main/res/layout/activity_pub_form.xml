<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.PubsBarsFinder.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_about"/>

                <CheckBox
                    android:id="@+id/favouriteCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/selector_favourite"
                    android:contentDescription="@string/label_favourite"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:buttonTint="@color/accent"
                    app:useMaterialThemeColors="false"/>

            </LinearLayout>

            <TextView
                android:id="@+id/titleLabel"
                style="@style/Widget.PubsBarsFinder.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/titleInput"
                android:text="@string/label_title"/>

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_title_input"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/titleError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_title_required"
                android:textColor="@color/error"
                android:textSize="13sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/descriptionLabel"
                style="@style/Widget.PubsBarsFinder.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/descriptionInput"
                android:text="@string/label_description"/>

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="@string/hint_description_input"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingHorizontal="14dp"
                android:paddingVertical="14dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"/>

            <TextView
                style="@style/Widget.PubsBarsFinder.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_photo"/>

            <ImageView
                android:id="@+id/photoPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_field"
                android:contentDescription="@string/content_description_photo"
                android:scaleType="center"
                android:src="@drawable/ic_photo_placeholder"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/choosePhotoButton"
                    style="@style/Widget.PubsBarsFinder.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/button_choose_photo"/>

                <Button
                    android:id="@+id/removePhotoButton"
                    style="@style/Widget.PubsBarsFinder.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/button_remove_photo"/>

            </LinearLayout>

            <TextView
                style="@style/Widget.PubsBarsFinder.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_amenities"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/amenityLiveMusic"
                    style="@style/Widget.PubsBarsFinder.AmenityCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_live_music"/>

                <CheckBox
                    android:id="@+id/amenityWheelchairAccessible"
                    style="@style/Widget.PubsBarsFinder.AmenityCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_wheelchair_accessible"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/amenitySportsOnTv"
                    style="@style/Widget.PubsBarsFinder.AmenityCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_sports_on_tv"/>

                <CheckBox
                    android:id="@+id/amenityPetFriendly"
                    style="@style/Widget.PubsBarsFinder.AmenityCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_pet_friendly"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/amenityBeerGarden"
                    style="@style/Widget.PubsBarsFinder.AmenityCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_beer_garden"/>

                <CheckBox
                    android:id="@+id/amenityFoodServed"
                    style="@style/Widget.PubsBarsFinder.AmenityCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_food_served"/>

            </LinearLayout>

            <TextView
                style="@style/Widget.PubsBarsFinder.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_location"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/latitudeLabel"
                        style="@style/Widget.PubsBarsFinder.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/latitudeInput"
                        android:text="@string/label_latitude"/>

                    <EditText
                        android:id="@+id/latitudeInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:hint="@string/hint_latitude_input"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/latitudeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/error_latitude_range"
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/longitudeLabel"
                        style="@style/Widget.PubsBarsFinder.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/longitudeInput"
                        android:text="@string/label_longitude"/>

                    <EditText
                        android:id="@+id/longitudeInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:hint="@string/hint_longitude_input"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/longitudeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/error_longitude_range"
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/coordinatesRangeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hint_coordinate_ranges"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/chooseOnMapButton"
                style="@style/Widget.PubsBarsFinder.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/button_choose_on_map"/>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.PubsBarsFinder.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/button_cancel"/>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.PubsBarsFinder.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/button_save_pub"/>

    </LinearLayout>

</LinearLayout>