<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_about"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/titleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/titleInput"
                android:text="@string/label_title"
                android:textColor="@color/text_label"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:hint="@string/hint_title_input"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/titleError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_title_required"
                android:textColor="@color/error"
                android:textSize="13sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/descriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/descriptionInput"
                android:text="@string/label_description"
                android:textColor="@color/text_label"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingHorizontal="14dp"
                android:paddingVertical="14dp"
                android:textColor="@color/text_primary"
                android:hint="@string/hint_description_input"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/section_amenities"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/amenityLiveMusic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_live_music"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"/>

                <CheckBox
                    android:id="@+id/amenityWheelchairAccessible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_wheelchair_accessible"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/amenitySportsOnTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_sports_on_tv"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"/>

                <CheckBox
                    android:id="@+id/amenityPetFriendly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_pet_friendly"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/amenityBeerGarden"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_beer_garden"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"/>

                <CheckBox
                    android:id="@+id/amenityFoodServed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/amenity_food_served"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_location"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/latitudeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/latitudeInput"
                        android:text="@string/label_latitude"
                        android:textColor="@color/text_label"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/latitudeInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:hint="@string/hint_latitude_input"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/latitudeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/error_latitude_range"
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:visibility="gone"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/longitudeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/longitudeInput"
                        android:text="@string/label_longitude"
                        android:textColor="@color/text_label"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/longitudeInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:hint="@string/hint_longitude_input"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/longitudeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/error_longitude_range"
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/coordinatesRangeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hint_coordinate_ranges"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/button_cancel"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/field_border"/>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:text="@string/button_save_pub"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</LinearLayout>